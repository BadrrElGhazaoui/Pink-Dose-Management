rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two accounts of Pink Dose Management can read or write anything.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['badr@pinkdose.app', 'ghita@pinkdose.app'];
    }
  }
}
